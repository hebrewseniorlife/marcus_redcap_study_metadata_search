<div class="row">
  <div class="col-md-12">
    <div class="card">
      <h5 class="card-header">Scheduler Details <small>(automatic reindex)</small></h5>
      <div class="card-body">
        <table class="table">
          <tr>
            <th>Schedule:</th>
            <td><pre>{{ schedule|json_encode(constant('JSON_PRETTY_PRINT'))|u.wordwrap(25) }}</pre></td>
          </tr>   
          <tr>
            <th>Last Job:</th>
            <td><pre>{{ last_job|json_encode(constant('JSON_PRETTY_PRINT'))|u.wordwrap(25) }}</pre></td>
          </tr>
{#}          {% if schedule.enabled == "enabled" %}
            <tr>
                <th>Pattern/Expression:</th>
                <td>{% if cron.schedule %}{{ cron.schedule.pattern }} ({{ cron.schedule.expression }}){% else %}N/A{% endif %}</td>
            </tr>          
            <tr>
                <th>Last Started:</th>
                <td>{% if cron.last_start_time | length > 0 %}{{ cron.last_start_time }}{% else %}N/A{% endif %}</td>
            </tr>          
            <tr>
                <th>Next Run Time:</th>
                <td>{% if cron.schedule %}{{ cron.schedule.next_run_time }}{% else %}N/A{% endif %}</td>
            </tr>    
          {% endif %}    #}      
        </table>
      </div>
    </div>
  </div>      
</div>